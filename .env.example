# --- Contact form delivery (Resend — https://resend.com) ---
# API key from the Resend dashboard.
RESEND_API_KEY=

# Where enquiries are delivered.
CONTACT_TO_EMAIL=keisha@kpatrice.com

# Sender address. IMPORTANT: this must be on a domain you have verified in
# Resend (Domains -> Add Domain, then add the DNS records it gives you).
# Resend rejects sends from unverified domains.
CONTACT_FROM_EMAIL=website@kpatriceglobal.com

# --- Scheduling ---
# Your Calendly event link, e.g. https://calendly.com/keisha-kpatrice/30min
# Set this and the contact form reveals the calendar (prefilled) after a
# successful submit, and the hero CTAs open it directly — matching the
# behaviour of the current GoHighLevel site.
# Leave empty and the CTAs scroll to the form, which just confirms the send.
NEXT_PUBLIC_CALENDLY_URL=
