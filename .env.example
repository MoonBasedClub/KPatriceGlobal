# --- Contact form delivery (Resend — https://resend.com) ---
# API key from the Resend dashboard.
RESEND_API_KEY=

# Where enquiries are delivered.
CONTACT_TO_EMAIL=keisha@kpatrice.com

# Sender address. IMPORTANT: this must be on a domain you have verified in
# Resend (Domains -> Add Domain, then add the DNS records it gives you).
# Resend rejects sends from unverified domains.
CONTACT_FROM_EMAIL=website@kpatriceglobal.com

# --- Scheduling ---
# The booking page embeds the GoHighLevel calendar the current site uses
# ("Keisha Smith's Personal Calendar"). Its ID is committed as the default, so
# nothing needs setting here. Override only to point at a different calendar:
# find the ID in GoHighLevel under Calendars -> the calendar -> its share/embed
# link, which ends in /widget/booking/<id>.
# NEXT_PUBLIC_BOOKING_CALENDAR_ID=
